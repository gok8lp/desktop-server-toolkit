#
msgid "Siyah bar: uygulama adanın altına yerleşir"
msgstr "Black bar: the app sits below the island"

msgid "Çentik: ada ekrana gömülü, hep görünür (MacBook gibi)"
msgstr ""
"Notch: the island is built into the screen, always visible (like a MacBook)"

#
#
msgid "Gizli çentik: sadece fareyle (oyun modu)"
msgstr "Hidden notch: pointer only (game mode)"

