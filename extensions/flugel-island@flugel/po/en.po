#
#
msgid "Oyun duyuruları"
msgstr "Game alerts"

msgid ""
"İstek listendeki oyunun fiyatı düşünce, yeni PS Plus oyunları ve Epic'te "
"yeni ücretsiz oyun"
msgstr ""
"When a game on your wishlist drops in price, new PS Plus games and a new "
"free game on Epic"

msgid "Bu sayfayı varsayılana döndür"
