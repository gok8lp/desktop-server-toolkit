<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="flugel-island">
  <enum id="org.gnome.shell.extensions.flugel-island.Tetik">
    <value nick="hover" value="0"/>
    <value nick="click" value="1"/>
  </enum>

  <schema id="org.gnome.shell.extensions.flugel-island" path="/org/gnome/shell/extensions/flugel-island/">
    <!-- Davranış -->
    <key name="dil" type="s">
      <choices><choice value="sistem"/><choice value="tr"/><choice value="en"/></choices>
      <default>'tr'</default>
      <summary>Arayüz dili (sistem, Türkçe, English)</summary>
    </key>
    <key name="vm-gizli" type="as">
      <default>[]</default>
      <summary>Sanal makineler sekmesinde gizlenen VM'ler</summary>
    </key>
    <key name="tetik" enum="org.gnome.shell.extensions.flugel-island.Tetik">
      <default>'hover'</default>
      <summary>Kartı açma biçimi</summary>
      <description>hover: üzerine gelince açılır, tıklayınca sabitlenir. click: sadece tıklayınca açılır.</description>
    </key>
    <key name="hover-gecikme" type="i">
      <range min="0" max="2000"/>
      <default>280</default>
      <summary>Üzerine gelince açılma gecikmesi (ms)</summary>
    </key>
    <key name="monitor" type="i">
      <default>-1</default>
      <summary>Island'ın gösterileceği ekran (-1 = birincil ekran)</summary>
    </key>
    <key name="ust-cubuk-sade" type="b">
      <default>true</default>
      <summary>Üst çubukta sadece Island kalsın (saat, pil, Hızlı Ayarlar, tepsi, Etkinlikler gizlenir; kısayollar çalışır)</summary>
    </key>
    <key name="sabit-uygulamalar" type="as">
      <default>['eclipse_eclipse.desktop', 'kitty.desktop', 'google-chrome.desktop', 'org.gnome.Nautilus.desktop']</default>
      <summary>Kısayollar ve Hızlı sekmesinde sabitlenmiş uygulamalar (.desktop kimlikleri, sırasıyla)</summary>
    </key>
    <key name="panik-onay" type="s">
      <choices><choice value="cift"/><choice value="basili"/></choices>
      <default>'cift'</default>
      <summary>Panik onayı: cift = ikinci tık, basili = 0,6 sn basılı tutma</summary>
    </key>
    <key name="anime-secili" type="as">
      <default>[]</default>
      <summary>Takip dışından eklenen animeler (MAL kimlikleri)</summary>
    </key>
    <key name="manga-secili" type="as">
      <default>[]</default>
      <summary>Takip dışından eklenen mangalar (MAL kimlikleri)</summary>
    </key>
    <key name="dock-buyume" type="b">
      <default>true</default>
      <summary>Alt dock: üzerine gelince simge hafifçe büyüsün</summary>
    </key>
    <key name="bildirim-sure" type="i">
      <range min="2000" max="20000"/>
      <default>6000</default>
      <summary>Bildirim afişinin adada kalma süresi (ms)</summary>
    </key>
    <key name="otomatik-guncelleme" type="s">
      <choices><choice value="kapali"/><choice value="gunluk"/><choice value="haftalik"/></choices>
      <default>'haftalik'</default>
      <summary>Otomatik güncelleme (apt, snap, flatpak): kapalı, günlük, haftalık</summary>
    </key>
    <key name="oyun-istek" type="s">
      <default>'[]'</default>
      <summary>Oyun istek listesi (JSON: Steam uygulama no, ad, son fiyat); fiyat düşünce adada uyarı</summary>
    </key>
    <key name="oyun-gorulen" type="s">
      <default>'{}'</default>
      <summary>İç kullanım: duyurulmuş PS Plus / Epic oyunları</summary>
    </key>
    <key name="yenileme-oyun" type="i">
      <range min="1800" max="86400"/>
      <default>10800</default>
      <summary>Oyun fiyatları ve duyurular yenileme aralığı (sn)</summary>
    </key>
    <key name="renk-gecmisi" type="as">
      <default>[]</default>
      <summary>Renk seçiciyle alınan son renkler (HEX)</summary>
    </key>
    <key name="hava-konum" type="s">
      <default>''</default>
      <summary>Hava durumu için şehir (boşsa hava gösterilmez)</summary>
    </key>
    <key name="yenileme-hava" type="i">
      <range min="300" max="7200"/>
      <default>900</default>
      <summary>Hava durumu yenileme aralığı (sn)</summary>
    </key>
    <key name="ayar-surumu" type="i">
      <default>0</default>
      <summary>İç kullanım: ayar göçü (yeni canlı etkinlik kaynakları eski listelere eklenir)</summary>
    </key>
    <key name="ada-yol-ver" type="b">
      <default>true</default>
      <summary>Çentiğin altına yazı imleci gelince ya da basılı tuşla sürüklerken ada yukarı çekilir</summary>
    </key>
    <key name="ada-gizle-kisayol" type="as">
      <default><![CDATA[['<Super><Alt>i']]]></default>
      <summary>Adayı geçici gizle / geri getir</summary>
    </key>
    <key name="medya-kaydirma" type="s">
      <choices><choice value="parca"/><choice value="sarma"/></choices>
      <default>'parca'</default>
      <summary>Oynatıcıda iki parmakla yatay kaydırma: parca = önceki/sonraki parça, sarma = 10 sn geri/ileri</summary>
    </key>
    <key name="ust-serit" type="s">
      <choices><choice value="siyah"/><choice value="centik"/><choice value="renkli"/><choice value="gizli"/><choice value="seffaf"/></choices>
      <default>'siyah'</default>
      <summary>Üst şerit: renkli = pencereler şeridin altından başlar, şerit uygulamanın rengini alır; gizli = pencereler en üste uzanır, ada çentik olur; seffaf = şeffaf şerit</summary>
    </key>
    <key name="pencere-centik" type="b">
      <default>true</default>
      <summary>Bir pencere adanın altına gelince (büyütülmüş tarayıcı vb.) ada tam ekrandaki gibi çentik olur</summary>
    </key>
    <key name="tam-ekran-kipi" type="s">
      <choices><choice value="centik"/><choice value="birlikte"/><choice value="gizli"/><choice value="bildirim"/><choice value="canli"/></choices>
      <default>'birlikte'</default>
      <summary>Tam ekranda ada (çentik): gizli = sadece fareyle, bildirim = bildirim/ses gelince de, canli = canlı etkinlik varken de</summary>
    </key>
    <key name="sunucu-sessiz" type="s">
      <default>'{}'</default>
      <summary>Susturulan sunucu bildirim kategorileri (JSON: kategori → bitiş zamanı, 0 = süresiz)</summary>
    </key>
    <key name="pip-konum" type="s">
      <default>''</default>
      <summary>Resim içinde resim penceresinin son konumu ve boyutu (JSON; boş = sol alt köşe)</summary>
    </key>
    <key name="son-sekme" type="s">
      <default>'hizli'</default>
      <summary>Kartta en son açılan sekme</summary>
    </key>

    <!-- Görünüm -->
    <key name="genislik-carpani" type="d">
      <range min="0.6" max="2.0"/>
      <default>1.0</default>
      <summary>Kapsül genişliği çarpanı</summary>
    </key>
    <key name="kart-genislik" type="i">
      <range min="560" max="960"/>
      <default>720</default>
      <summary>Genişletilmiş kartın genişliği (mantıksal piksel)</summary>
    </key>
    <key name="saydamlik" type="i">
      <range min="40" max="100"/>
      <default>92</default>
      <summary>Kapsülün opaklığı (%)</summary>
    </key>
    <key name="kart-saydamlik" type="i">
      <range min="60" max="100"/>
      <default>95</default>
      <summary>Açık kartın opaklığı (%)</summary>
    </key>
    <key name="pano-favoriler" type="as">
      <default>[]</default>
      <summary>Pano yöneticisinde yıldızlanan metinler (kalıcı)</summary>
    </key>
    <key name="renk-zaman" type="as">
      <default>[]</default>
      <summary>Renk geçmişindeki renklerin seçildiği an ("HEX=ms")</summary>
    </key>
    <key name="tasarim" type="s">
      <choices><choice value="atoll"/><choice value="klasik"/><choice value="v3"/></choices>
      <default>'atoll'</default>
      <summary>Tasarım: atoll (Atoll düzeni), klasik (v2.8.0 görünümü) ya da v3 (Quiet Orbit: beş grup, sade hareket)</summary>
    </key>
    <key name="hizli-araclar" type="as">
      <default>['uyku', 'goruntu', 'zaman', 'pano']</default>
      <summary>v3 Hızlı kısa görünümündeki araçlar (en çok dört, sırasıyla)</summary>
    </key>
    <key name="hizli-not" type="s">
      <default>''</default>
      <summary>Hızlı not (Hızlı sekmesi, Araçlar → Not)</summary>
    </key>
    <key name="cam-efekti" type="b">
      <default>true</default>
      <summary>Buzlu cam: kart açıkken altındaki pencereler bulanık görünür (iOS tarzı)</summary>
    </key>
    <key name="cam-bulaniklik" type="i">
      <range min="4" max="60"/>
      <default>30</default>
      <summary>Camın bulanıklık yarıçapı (mantıksal piksel)</summary>
    </key>
    <key name="cam-saydamlik" type="i">
      <range min="30" max="100"/>
      <default>72</default>
      <summary>Cam açıkken kartın renk katmanının opaklığı (%)</summary>
    </key>
    <key name="bulanik-gecis" type="b">
      <default>true</default>
      <summary>İçerik değişirken bulanık geçiş (eski içerik bulanıklaşıp gider, yenisi netleşerek gelir)</summary>
    </key>
    <key name="animasyon-hizi" type="d">
      <range min="0.5" max="2.0"/>
      <default>1.0</default>
      <summary>Animasyon hızı çarpanı (sistemde "animasyonları azalt" açıksa animasyon hiç yapılmaz)</summary>
    </key>
    <key name="ekip-surpriz" type="b">
      <default>true</default>
      <summary>Re:Zero sürprizi: ara sıra bir karakter adanın kenarında görünür (5 hızlı tık da çağırır)</summary>
    </key>

    <!-- Canlı etkinlikler -->
    <key name="etkin-saglayicilar" type="as">
      <default>['privacy', 'bildirim', 'panik', 'sunucu', 'gpu-vm', 'media', 'zamanlayici', 'indirme', 'oyun', 'basket', 'anime', 'kripto', 'osd', 'power', 'cihaz', 'odak', 'akis']</default>
      <summary>Açık canlı etkinlik kaynakları</summary>
    </key>
    <key name="oncelik-sirasi" type="as">
      <default>['privacy', 'bildirim', 'panik', 'sunucu', 'gpu-vm', 'media', 'zamanlayici', 'indirme', 'oyun', 'basket', 'anime', 'kripto', 'osd', 'power', 'cihaz', 'odak', 'notification', 'akis', 'keyboard']</default>
      <summary>Canlı etkinliklerin öncelik sırası (ilk = en önemli)</summary>
    </key>
    <key name="transient-duration-ms" type="i">
      <range min="500" max="10000"/>
      <default>1800</default>
      <summary>Kısa süreli bildirimlerin (ses, şarj, cihaz) ekranda kalma süresi (ms)</summary>
    </key>
    <key name="osd-yerine" type="b">
      <default>true</default>
      <summary>Ses/parlaklık için GNOME'un ekran ortasındaki göstergesi yerine Island'ı kullan</summary>
    </key>
    <key name="kripto-esik" type="d">
      <range min="1.0" max="50.0"/>
      <default>5.0</default>
      <summary>Kripto büyük değişim eşiği (24 saatlik %)</summary>
    </key>
    <key name="mac-canli-etkinlik" type="b">
      <default>true</default>
      <summary>Canlı maç olunca kapsülde canlı etkinlik olarak göster</summary>
    </key>
    <key name="mac-favoriler" type="as">
      <default>['Turkey']</default>
      <summary>Favori takımlar (futbol, basketbol, milli, CS2; ad içinde geçen metin, büyük/küçük harf ve aksan önemsiz)</summary>
    </key>
    <key name="mac-ozel" type="as">
      <default>[]</default>
      <summary>Özel maçlar (sabitlenen maç anahtarları)</summary>
    </key>
    <key name="mac-kategori" type="s">
      <default>'onemli'</default>
      <summary>Maçlar sekmesinde son seçilen kategori</summary>
    </key>
    <key name="mac-kategoriler" type="as">
      <default>['onemli', 'futbol', 'basketbol', 'milli', 'derbi', 'takimlar', 'ozel', 'cs2']</default>
      <summary>Gösterilen kategoriler ve sırası</summary>
    </key>
    <key name="mac-min-yildiz" type="i">
      <range min="0" max="5"/>
      <default>2</default>
      <summary>Öne çıkanlar: en az bu kadar yıldızlı maçlar (favoriler, derbiler ve özel maçlar her zaman)</summary>
    </key>
    <key name="cs2-etkin" type="b">
      <default>true</default>
      <summary>CS2 maçları (HLTV)</summary>
    </key>
    <key name="cs2-min-yildiz" type="i">
      <range min="0" max="5"/>
      <default>1</default>
      <summary>Canlı CS2 maçı kapsülde: en az bu kadar HLTV yıldızı (favori takımlar her zaman)</summary>
    </key>
    <key name="cs2-takip" type="i">
      <default>0</default>
      <summary>Kapsülde takip edilen CS2 maçı (HLTV maç numarası, 0 = otomatik)</summary>
    </key>
    <key name="yenileme-cs2" type="i">
      <range min="20" max="600"/>
      <default>40</default>
      <summary>CS2 yenileme aralığı (sn; canlı maç yokken veri 5 dk önbellekten gelir)</summary>
    </key>
    <key name="kripto-varliklar" type="as">
      <default>['BTC', 'ETH', 'SOL', 'BNB', 'XRP', 'DOGE', 'USD', 'EUR']</default>
      <summary>Kripto izleme listesi (Binance sembolleri; USD ve EUR: TL karşılığı), kartlar bu sırayla dizilir</summary>
    </key>
    <key name="kripto-alarmlar" type="s">
      <default>'[]'</default>
      <summary>Fiyat alarmları (JSON: [{id, s, fiyat, yon}])</summary>
    </key>
    <key name="kripto-isaretler" type="s">
      <default>'{}'</default>
      <summary>Grafik işaretleri (JSON: {sembol: [fiyat]})</summary>
    </key>
    <key name="kripto-donem" type="s">
      <choices><choice value="1s"/><choice value="24s"/><choice value="7g"/><choice value="30g"/><choice value="1y"/></choices>
      <default>'24s'</default>
      <summary>Ayrıntı grafiğinin açılış dönemi</summary>
    </key>
    <key name="kripto-mini-grafik" type="b">
      <default>true</default>
      <summary>Kartlarda küçük grafik</summary>
    </key>
    <key name="kripto-alarm-ses" type="b">
      <default>true</default>
      <summary>Alarm çalınca ses</summary>
    </key>
    <key name="kripto-renk" type="b">
      <default>false</default>
      <summary>Değişimde renk kullan (kapalıysa siyah-beyaz)</summary>
    </key>
    <key name="basket-yakin-dk" type="i">
      <range min="15" max="720"/>
      <default>120</default>
      <summary>Maç kaç dakika kala "yaklaşıyor" sayılır</summary>
    </key>
    <key name="anime-yakin-dk" type="i">
      <range min="5" max="720"/>
      <default>60</default>
      <summary>Bölüm kaç dakika kala gösterilir</summary>
    </key>
    <key name="power-low-threshold" type="i">
      <range min="5" max="50"/>
      <default>15</default>
      <summary>Düşük pil uyarısı eşiği (%)</summary>
    </key>
    <key name="cihaz-dusuk-esik" type="i">
      <range min="5" max="50"/>
      <default>20</default>
      <summary>Klavye/fare pili düşük eşiği (%)</summary>
    </key>
    <key name="notification-excluded-apps" type="as">
      <default>[]</default>
      <summary>Bildirim afişinde gösterilmeyecek uygulamalar (.desktop kimliği)</summary>
    </key>
    <key name="notification-coalesce-threshold" type="i">
      <range min="1" max="20"/>
      <default>3</default>
      <summary>Bu sayıdan çok bildirim birikince tek satırda say</summary>
    </key>
    <key name="keyboard-flash-caps-lock" type="b">
      <default>true</default>
      <summary>Caps Lock değişince göster</summary>
    </key>
    <key name="keyboard-flash-layout-switch" type="b">
      <default>true</default>
      <summary>Klavye düzeni değişince göster</summary>
    </key>
    <key name="sunucu-goruldu" type="s">
      <default>''</default>
      <summary>Kapatılan son sunucu uyarısının imzası (aynı sorun tekrar gösterilmez)</summary>
    </key>

    <!-- Yenileme aralıkları (saniye) -->
    <key name="yenileme-sunucu" type="i">
      <range min="10" max="600"/>
      <default>20</default>
      <summary>Sunucu durumu yenileme aralığı (sn)</summary>
    </key>
    <key name="yenileme-kripto" type="i">
      <range min="15" max="600"/>
      <default>30</default>
      <summary>Kripto/döviz yenileme aralığı (sn)</summary>
    </key>
    <key name="yenileme-pc" type="i">
      <range min="5" max="600"/>
      <default>15</default>
      <summary>Bu PC durumu yenileme aralığı (sn)</summary>
    </key>
    <key name="yenileme-anime" type="i">
      <range min="300" max="7200"/>
      <default>900</default>
      <summary>Anime listesi yenileme aralığı (sn)</summary>
    </key>
    <key name="yenileme-maclar" type="i">
      <range min="60" max="3600"/>
      <default>300</default>
      <summary>Maçlar yenileme aralığı (sn; canlı maç varken sunucu 2 dk'da bir günceller)</summary>
    </key>
    <key name="pil-carpani" type="i">
      <range min="1" max="10"/>
      <default>4</default>
      <summary>Pildeyken / Pil Tasarrufu açıkken yenileme aralıkları kaç kat uzasın</summary>
    </key>
  </schema>
</schemalist>
