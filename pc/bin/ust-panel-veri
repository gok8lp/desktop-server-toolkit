#!/usr/bin/env python3
"""Ust panel eklentisi icin veri: kripto fiyatlari, bu PC ve sunucu durumu (JSON).
Kullanim: ust-panel-veri kripto | canli | grafik | kripto-izle A,B | kripto-liste | koin SYM DONEM | maclar | pc | sunucu | island | basket | anime     (sistem-bakim)
Evde LAN, disarida Tailscale uzerinden sunucuya ulasir (ssh config Match kurali)."""
import json, os, subprocess, sys, time, urllib.parse, urllib.request

CACHE = os.path.expanduser("~/.cache/sistem-bakim")
os.makedirs(CACHE, exist_ok=True)

COINS = [("bitcoin", "BTC", "₿"), ("ethereum", "ETH", "Ξ"), ("solana", "SOL", "◎"),
         ("binancecoin", "BNB", "B"), ("ripple", "XRP", "✕"), ("dogecoin", "DOGE", "Ð"),
         ("avalanche-2", "AVAX", "A"), ("cardano", "ADA", "₳")]


def cached(name, max_age, fn):
    """fn() sonucunu max_age saniye onbellekte tutar; hata olursa eski veriyi dondurur."""
    p = os.path.join(CACHE, name + ".json")
    try:
        if time.time() - os.path.getmtime(p) < max_age:
            return json.load(open(p))
    except OSError:
        pass
    try:
        data = fn()
        json.dump(data, open(p, "w"))
        return data
    except Exception as e:  # ag yoksa eski veriyi goster
        try:
            old = json.load(open(p))
            old["eski"] = True
            return old
        except Exception:
            return {"hata": str(e)[:80]}


PAPRIKA = {"bitcoin": "btc-bitcoin", "ethereum": "eth-ethereum", "solana": "sol-solana",
           "binancecoin": "bnb-binance-coin", "ripple": "xrp-xrp", "dogecoin": "doge-dogecoin",
           "avalanche-2": "avax-avalanche", "cardano": "ada-cardano"}


def kripto_paprika():
    """Yedek kaynak: bazi aglar (okul/operator) borsa API'lerini engelliyor, CoinPaprika genelde acik."""
    req = urllib.request.Request("https://api.coinpaprika.com/v1/tickers?quotes=USD,TRY,EUR",
                                 headers={"User-Agent": "flugel-panel/1.0"})
    d = {t["id"]: t for t in json.load(urllib.request.urlopen(req, timeout=15))}
    out = []
    for cid, sym, ikon in COINS:
        t = d.get(PAPRIKA[cid])
        if t:
            q = t["quotes"]
            out.append({"sym": sym, "ikon": ikon, "usd": q["USD"]["price"], "try": q.get("TRY", {}).get("price"), "eur": q.get("EUR", {}).get("price"),
                        "degisim": round(q["USD"].get("percent_change_24h") or 0, 2)})
    return {"coinler": out, "zaman": time.strftime("%H:%M"), "kaynak": "CoinPaprika"}


def kripto():
    try:
        d = kripto_gecko()
    except Exception:
        d = kripto_paprika()
    b = next((c for c in d["coinler"] if c["sym"] == "BTC"), None)
    if b and b.get("usd") and b.get("try"):
        d["usdtry"] = round(b["try"] / b["usd"], 2)
        if b.get("eur"):
            d["eurtry"] = round(b["try"] / b["eur"], 2)
    return d


def kripto_gecko():
    ids = ",".join(c[0] for c in COINS)
    url = ("https://api.coingecko.com/api/v3/simple/price?ids=%s&vs_currencies=usd,try,eur"
           "&include_24hr_change=true" % ids)
    req = urllib.request.Request(url, headers={"User-Agent": "flugel-panel/1.0"})
    d = json.load(urllib.request.urlopen(req, timeout=10))
    out = []
    for cid, sym, ikon in COINS:
        if cid in d:
            v = d[cid]
            out.append({"sym": sym, "ikon": ikon, "usd": v.get("usd"), "try": v.get("try"), "eur": v.get("eur"),
                        "degisim": round(v.get("usd_24h_change") or 0, 2)})
    return {"coinler": out, "zaman": time.strftime("%H:%M"), "kaynak": "CoinGecko"}


def canli():
    """Anlik fiyatlar (Yahoo Finance, birkac saniye gecikmeli): BTC, ETH, USD/TRY, EUR/TRY."""
    from concurrent.futures import ThreadPoolExecutor

    def al(cift):
        anahtar, sembol = cift
        try:
            req = urllib.request.Request(f"https://query1.finance.yahoo.com/v8/finance/chart/{sembol}?range=1d&interval=1m",
                                         headers={"User-Agent": "Mozilla/5.0"})
            m = json.load(urllib.request.urlopen(req, timeout=8))["chart"]["result"][0]["meta"]
            p, o = m["regularMarketPrice"], (m.get("chartPreviousClose") or m.get("previousClose"))
            return anahtar, {"fiyat": p, "degisim": round((p - o) / o * 100, 2) if o else 0}
        except Exception:
            return anahtar, None
    with ThreadPoolExecutor(4) as h:
        out = {k: v for k, v in h.map(al, (("btc", "BTC-USD"), ("eth", "ETH-USD"), ("usdtry", "USDTRY=X"), ("eurtry", "EURTRY=X"))) if v}
    if "btc" not in out:  # Yahoo da kapaliysa genel kripto verisine dus
        k = cached("kripto", 110, kripto)
        for c in k.get("coinler", []):
            if c["sym"] in ("BTC", "ETH"):
                out[c["sym"].lower()] = {"fiyat": c["usd"], "degisim": c["degisim"]}
        for a in ("usdtry", "eurtry"):
            if k.get(a):
                out[a] = {"fiyat": k[a], "degisim": None}
    out["zaman"] = time.strftime("%H:%M:%S")
    if "btc" not in out:
        raise RuntimeError("fiyat alinamadi")
    return out


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=8).stdout.strip()


def pc():
    def oku(p, d=""):
        try:
            return open(p).read().strip()
        except OSError:
            return d
    cpu1 = [int(x) for x in oku("/proc/stat").split("\n")[0].split()[1:]]
    time.sleep(0.4)
    cpu2 = [int(x) for x in oku("/proc/stat").split("\n")[0].split()[1:]]
    top = sum(cpu2) - sum(cpu1); bos = (cpu2[3] + cpu2[4]) - (cpu1[3] + cpu1[4])
    mem = {l.split(":")[0]: int(l.split()[1]) for l in oku("/proc/meminfo").split("\n") if l}
    st = os.statvfs("/")
    temp = sh("sensors 2>/dev/null | awk '/Package id 0/{gsub(/[+°C]/,\"\",$4); print int($4); exit}'")
    gpu = sh("nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null")
    bat = oku("/sys/class/power_supply/BAT0/capacity", "?")
    bdurum = {"Charging": "şarj oluyor", "Discharging": "pilde", "Full": "dolu",
              "Not charging": "prizde"}.get(oku("/sys/class/power_supply/BAT0/status"), "")
    kalan = sh("upower -i /org/freedesktop/UPower/devices/battery_BAT0 | awk -F: '/time to (empty|full)/{gsub(/^ +/,\"\",$2); print $2}'")
    wifi = sh("nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1==\"yes\"{print $2; exit}'")
    ts = sh("tailscale status --json 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get(\"BackendState\",\"\"))'")
    return {"cpu": round(100 * (top - bos) / max(top, 1)),
            "ram": "%.1f/%.0f GB" % ((mem["MemTotal"] - mem["MemAvailable"]) / 1048576, mem["MemTotal"] / 1048576),
            "ram_kul": round((mem["MemTotal"] - mem["MemAvailable"]) / 1048576, 1), "ram_top": round(mem["MemTotal"] / 1048576),
            "disk": "%d%%" % round(100 * (1 - st.f_bavail / st.f_blocks)),
            "temp": temp, "gpu": gpu, "pil": bat, "pil_durum": bdurum, "pil_kalan": kalan,
            "wifi": wifi, "tailscale": ts, "uptime": sh("uptime -p").replace("up ", "")}


UZAK = r'''
import json, os, subprocess, time
def sh(c):
    try: return subprocess.run(c, shell=True, capture_output=True, text=True, timeout=8).stdout.strip()
    except Exception: return ""
def oku(p, d=""):
    try: return open(os.path.expanduser(p)).read().strip()
    except OSError: return d
c1 = [int(x) for x in oku("/proc/stat").split("\n")[0].split()[1:]]; time.sleep(0.5)
c2 = [int(x) for x in oku("/proc/stat").split("\n")[0].split()[1:]]
t = sum(c2) - sum(c1); b = (c2[3] + c2[4]) - (c1[3] + c1[4])
m = {l.split(":")[0]: int(l.split()[1]) for l in oku("/proc/meminfo").split("\n") if l}
dur = oku("~/sistem-bakim/durum/.durum", "?").split("\n")
disk = {}
for mp in ("/", "/mnt/side", "/mnt/sidemain"):
    try:
        s = os.statvfs(mp); disk[mp] = round(100 * (1 - s.f_bavail / s.f_blocks))
    except OSError: disk[mp] = None
g = sh("nvidia-smi --query-gpu=temperature.gpu,power.draw,utilization.gpu --format=csv,noheader,nounits").split(", ")
print(json.dumps({
    "durum": dur[0] or "?", "sorunlar": "; ".join(x for x in dur[1:4] if x),
    "cpu": round(100 * (t - b) / max(t, 1)),
    "temp": sh("sensors 2>/dev/null | awk '/Tctl|Tdie/{gsub(/[+°C]/,\"\",$2); print int($2); exit}'"),
    "ram_kul": round((m["MemTotal"] - m["MemAvailable"]) / 1048576, 1), "ram_top": round(m["MemTotal"] / 1048576),
    "swap": round((m["SwapTotal"] - m["SwapFree"]) / 1048576, 1),
    "yuk": oku("/proc/loadavg").split()[0], "uptime": sh("uptime -p").replace("up ", ""),
    "disk": disk,
    "gpu_temp": g[0] if g and g[0] else "", "gpu_w": g[1] if len(g) > 1 else "", "gpu_kul": g[2] if len(g) > 2 else "",
    "konteyner": sh("echo $(docker ps -q | wc -l)/$(docker ps -aq | wc -l)"),
    "vpn": sh("docker inspect -f '{{.State.Health.Status}}' gluetun"),
    "yedek": oku("/var/lib/sistem-bakim/son-kritik-yedek", "-"),
    "vm": sh("virsh -c qemu:///system list --name 2>/dev/null | grep -c .")}))
'''


ISLAND_ADRESLER = ("http://192.168.0.15:3012/api/island", "https://flugelserver.tail42f1f4.ts.net:8443/api/island")


def island(yol="/api/island"):
    """Sunucunun hazirladigi tek durum paketi (v2): once ev agi, olmazsa Tailscale. SSH acmaz."""
    son = None
    for i, adres in enumerate(ISLAND_ADRESLER):
        try:
            with urllib.request.urlopen(adres.replace("/api/island", yol), timeout=(3 if i == 0 else 8) * (4 if yol != "/api/island" else 1)) as y:
                d = json.load(y)
            d["kaynak"] = "lan" if i == 0 else "tailscale"
            return d
        except Exception as e:  # sonraki adresi dene
            son = e
    raise RuntimeError(f"sunucuya ulasilamadi: {son}")


def sunucu():
    """v1 panelinin bekledigi bicim; once /api/island, olmazsa eski SSH yolu."""
    try:
        d = island()
        return {**d, "sorunlar": "; ".join(d.get("sorunlar") or []), "vm": str(d.get("vm_acik", 0))}
    except Exception:
        pass
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", "-o", "ControlPath=none",
                        "flugelserver", "python3", "-"], input=UZAK, capture_output=True, text=True, timeout=25)
    if r.returncode != 0 or not r.stdout.strip():
        raise RuntimeError("sunucuya ulasilamadi")
    return json.loads(r.stdout)


YEDEK = os.path.expanduser("~/.local/share/flugel-bot/durum")


def sunucu_ya_da_yedek(dosya):
    """Once sunucudaki guncel veri; sunucu kapaliysa bu PC'deki yedek botun verisi."""
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "ControlPath=none",
                        "flugelserver", "cat", "/var/lib/basket-bot/" + dosya], capture_output=True, text=True, timeout=15)
    if r.returncode == 0 and r.stdout.strip():
        return json.loads(r.stdout), False
    return json.load(open(os.path.join(YEDEK, dosya))), True


def basket():
    d, yedek = sunucu_ya_da_yedek("maclar.json")
    return {"gelecek": d.get("gelecek", [])[:10], "guncelleme": d.get("guncelleme"),
            "taranan": len(d.get("taranan", [])), "isimler": d.get("isimler", []), "hatalar": len(d.get("hatalar", [])),
            "yedek": yedek}


MAL_OZET = os.path.expanduser("~/.cache/flugel-island/mal-ozet.json")


def mal_ozetleri(kayitlar, en_fazla=20):
    """Her kayda MAL özeti (synopsis, İngilizce) ve türler ekler — doğrudan myanimelist.net sayfasından
    (Jikan erişilemiyor). Yeni olanlardan en fazla en_fazla tanesi, istekler arası 1,2 sn."""
    try:
        bellek = json.load(open(MAL_OZET))
    except Exception:
        bellek = {}
    yeni = 0
    for tur, x in kayitlar:
        k = f"{tur}:{x.get('id')}"
        if k not in bellek and yeni < en_fazla and x.get("id"):
            try:
                import html as _html
                import re as _re
                sayfa = urllib.request.urlopen(urllib.request.Request(f"https://myanimelist.net/{tur}/{x['id']}",
                    headers={"User-Agent": "Mozilla/5.0 FLUGEL"}), timeout=12).read().decode("utf-8", "replace")
                m = _re.search(r'<(?:p|span) itemprop="description">(.*?)</(?:p|span)>', sayfa, _re.S)
                ozet = _html.unescape(_re.sub(r"<[^>]+>", "", m.group(1))).replace("[Written by MAL Rewrite]", "").strip() if m else ""
                sira = _re.findall(r"Ranked:</span>\s*#(\d+)", sayfa)
                uye = _re.findall(r"Members:</span>\s*([\d,]+)", sayfa)
                bellek[k] = {"ozet": ozet, "tur": _re.findall(r'<span itemprop="genre"[^>]*>([^<]+)</span>', sayfa)[:4],
                             "studyo": _re.findall(r'/anime/producer/\d+/[^"]*" title="([^"]+)"', sayfa)[:2],
                             "siralama": int(sira[0]) if sira else None, "populerlik": None,
                             "uye": int(uye[0].replace(",", "")) if uye else None}
                yeni += 1
                time.sleep(1.2)
            except Exception:
                break   # ağ yok ya da hız sınırı: sonraki yenilemede devam
        b = bellek.get(k)
        if b:
            x.update({"mal_ozet": b["ozet"], "mal_tur": b["tur"], "mal_studyo": b["studyo"], "mal_sira": b["siralama"],
                      "mal_uye": b["uye"]})
    if yeni:
        os.makedirs(RESIM_KOK, exist_ok=True)
        json.dump(bellek, open(MAL_OZET + ".yeni", "w"), ensure_ascii=False)
        os.replace(MAL_OZET + ".yeni", MAL_OZET)


def anime():
    d, yedek = sunucu_ya_da_yedek("anime.json")
    takip = d.get("anime", []) + d.get("manga", []) + d.get("trend", [])
    secim = d.get("sezon", []) + d.get("diger", []) + d.get("manga_diger", [])
    # kapaklar diskte, net gorunsun diye en buyuk kaynaktan (extraLarge) ve HiDPI icin 2 kat:
    # kucuk 300 px (karo ~110 px), buyuk 640 px (onizleme ~240 px); JPEG kalite 94
    kaynak = lambda x: x.get("kapak_buyuk") or x.get("kapak")
    kucuk = resimleri_onbellekle([kaynak(x) for x in takip + secim], "kapak", (300,))
    buyuk = resimleri_onbellekle([kaynak(x) for x in takip], "kapak", (640,))
    for x in takip + secim:
        x["kapak_kucuk"] = (kucuk.get(kaynak(x)) or {}).get(300)
        x["kapak_buyuk_yol"] = (buyuk.get(kaynak(x)) or {}).get(640)
    # MyAnimeList'in kendi İngilizce özeti (MAL sayfası; yavaş ve kalıcı önbellekli)
    mal_ozetleri([("anime", a) for a in d.get("anime", [])] + [("manga", m) for m in d.get("manga", [])])
    return {"anime": d.get("anime", []), "manga": d.get("manga", []), "trend": d.get("trend", []),
            "sezon": d.get("sezon", []), "diger": d.get("diger", []), "manga_diger": d.get("manga_diger", []),
            "guncelleme": d.get("guncelleme"), "yedek": yedek}


# ---------- resim onbellegi (takim logolari, anime/manga kapaklari) ----------
# Her resim bir kez indirilir, istenen boyutlara kucultulup ~/.cache/flugel-island/<klasor>/ altina yazilir.
# Island resmi diskten okur (agdan resim cekmez). Paralel, en fazla 6 baglanti.
RESIM_KOK = os.path.expanduser("~/.cache/flugel-island")


def resim_yolu(url, klasor, boyut):
    import hashlib
    ad = hashlib.sha1(url.encode()).hexdigest()[:16]
    # kapaklar fotograf: JPEG (kucuk); logolar saydam: PNG
    return os.path.join(RESIM_KOK, klasor, f"{ad}-{boyut}.{'jpg' if klasor == 'kapak' else 'png'}")


def resimleri_onbellekle(urller, klasor, boyutlar):
    """urller icin her boyutta kucuk PNG uretir; {url: {boyut: yol}} dondurur (indirilemeyenler atlanir)."""
    from concurrent.futures import ThreadPoolExecutor
    os.makedirs(os.path.join(RESIM_KOK, klasor), exist_ok=True)

    def bir(url):
        yollar = {b: resim_yolu(url, klasor, b) for b in boyutlar}
        if all(os.path.exists(y) for y in yollar.values()):
            return url, yollar
        try:
            from io import BytesIO
            from PIL import Image
            ham = urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "FLUGEL"}), timeout=10).read()
            im = Image.open(BytesIO(ham)).convert("RGBA")
            for b, y in yollar.items():
                k = im.copy()
                # kapakta b = genislik (oran korunur, buyutulmez); logoda kare kutu
                k.thumbnail((b, b * 3) if klasor == "kapak" else (b, b), Image.LANCZOS)
                if y.endswith(".jpg"):
                    k.convert("RGB").save(y + ".yeni", "JPEG", quality=94, subsampling=0)
                else:
                    k.save(y + ".yeni", "PNG")
                os.replace(y + ".yeni", y)
            return url, yollar
        except Exception:
            return url, None
    with ThreadPoolExecutor(6) as h:
        return {u: y for u, y in h.map(bir, sorted(set(u for u in urller if u))) if y}


MAC_LIGLER = [("Süper Lig", "soccer/tur.1"), ("Premier Lig", "soccer/eng.1"), ("La Liga", "soccer/esp.1"),
              ("Serie A", "soccer/ita.1"), ("Bundesliga", "soccer/ger.1"), ("Ligue 1", "soccer/fra.1"),
              ("Şampiyonlar Ligi", "soccer/uefa.champions"), ("Avrupa Ligi", "soccer/uefa.europa"), ("NBA", "basketball/nba")]
GUN_AD = ["Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar"]
AY_AD = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"]


def maclar_yerel(lig_listesi=None):
    """Sunucu kapaliysa ayni veriyi bu PC'de ESPN'den hesaplar (sunucudaki akis.py island_maclar ile ayni bicim)."""
    lig_listesi = lig_listesi or MAC_LIGLER
    import datetime as dt
    from concurrent.futures import ThreadPoolExecutor
    bugun = dt.date.today()
    gunler = [bugun - dt.timedelta(days=2), bugun - dt.timedelta(days=1), bugun, bugun + dt.timedelta(days=1)]

    def getir(is_):
        lig, yol, g = is_
        try:
            url = f"https://site.api.espn.com/apis/site/v2/sports/{yol}/scoreboard?dates={g:%Y%m%d}"
            return [(lig, e) for e in json.load(urllib.request.urlopen(url, timeout=10)).get("events", [])]
        except Exception:
            return []
    tablo, gorulen = {g: {} for g in gunler}, set()
    isler = [(l, y, g) for l, y in lig_listesi for g0 in gunler for g in (g0 - dt.timedelta(days=1), g0)]
    with ThreadPoolExecutor(8) as h:
        for sonuc in h.map(getir, sorted(set(isler))):
            for lig, e in sonuc:
                if e["id"] in gorulen:
                    continue
                ts = int(dt.datetime.fromisoformat(e["date"].replace("Z", "+00:00")).timestamp())
                g = dt.date.fromtimestamp(ts)
                if g not in tablo:
                    continue
                gorulen.add(e["id"])
                c = e["competitions"][0]
                t = {x["homeAway"]: x for x in c["competitors"]}
                st = e["status"]["type"]
                takim = lambda x: {"ad": x["team"].get("shortDisplayName") or x["team"].get("displayName"),
                                   "logo": x["team"].get("logo"), "skor": x.get("score")}
                tablo[g].setdefault(lig, []).append({
                    "ev": takim(t["home"]), "dep": takim(t["away"]), "ts": ts, "durum": st["state"],
                    "detay": st.get("shortDetail"), "link": next((l["href"] for l in e.get("links", []) if "summary" in l.get("rel", [])), None)})
    sira = [l for l, _ in lig_listesi]

    def ligler(g, sadece_biten=False):
        out = []
        for l in sira:
            ms = sorted([m for m in tablo[g].get(l, []) if not sadece_biten or m["durum"] == "post"], key=lambda m: m["ts"])
            if ms:
                out.append({"lig": l, "maclar": ms})
        return out
    try:
        bot = json.load(open(os.path.join(YEDEK, "maclar.json")))
    except Exception:
        bot = {}
    hepsi, b, y = bot.get("maclar", []), str(bugun), str(bugun + dt.timedelta(days=1))
    benim = {"bugun": [m for m in hepsi if m.get("tarih") == b], "yarin": [m for m in hepsi if m.get("tarih") == y],
             "yaklasan": [m for m in bot.get("gelecek", []) if m.get("tarih", "") > y][:5],
             "gecmis": sorted([m for m in hepsi if m.get("tarih", "") < b], key=lambda m: (m.get("tarih", ""), m.get("saat", "")), reverse=True)[:5],
             "guncelleme": bot.get("guncelleme"), "isimler": bot.get("isimler", [])}
    return {"benim": benim, "bugun": ligler(bugun), "yarin": ligler(bugun + dt.timedelta(days=1)),
            "gecmis": [{"tarih": str(g), "gun": f"{GUN_AD[g.weekday()]} {g.day} {AY_AD[g.month - 1]}", "ligler": ligler(g, True)} for g in gunler[1::-1]],
            "canli": any(m["durum"] == "in" for g in gunler for l in tablo[g].values() for m in l), "zaman": int(time.time()), "yedek": True}


# milli takim maclari (sunucu listesinde yok; bu PC'de ESPN'den, 5 dk onbellek)
MILLI_LIGLER = [("Dünya Kupası", "soccer/fifa.world"), ("Dünya Kupası Elemeleri", "soccer/fifa.worldq.uefa"),
                ("Uluslar Ligi", "soccer/uefa.nations"), ("Avrupa Şampiyonası Elemeleri", "soccer/uefa.euroq"),
                ("Hazırlık maçları", "soccer/fifa.friendly")]
# HLTV'deki gibi 0-5 yildiz: lig agirligi + buyuk takimlar + derbi (futbol/basketbol icin kendi olcumuz)
LIG_YILDIZ = {"Şampiyonlar Ligi": 2, "Dünya Kupası": 3, "Avrupa Ligi": 1, "Süper Lig": 1, "Premier Lig": 1, "La Liga": 1,
              "Serie A": 1, "Bundesliga": 1, "Ligue 1": 1, "NBA": 1, "Uluslar Ligi": 1, "Dünya Kupası Elemeleri": 1,
              "Avrupa Şampiyonası Elemeleri": 1}
BUYUKLER = ["galatasaray", "fenerbahce", "besiktas", "trabzonspor", "real madrid", "barcelona", "bayern", "man city",
            "manchester city", "liverpool", "arsenal", "chelsea", "man united", "manchester united", "paris saint", "psg",
            "internazionale", "inter milan", "ac milan", "juventus", "atletico", "dortmund", "napoli", "tottenham",
            "lakers", "celtics", "warriors", "nuggets", "thunder", "knicks", "turkey", "turkiye", "spain", "france",
            "england", "germany", "argentina", "brazil", "portugal", "italy", "netherlands"]
DERBILER = [("galatasaray", "fenerbahce"), ("galatasaray", "besiktas"), ("fenerbahce", "besiktas"),
            ("trabzonspor", "fenerbahce"), ("trabzonspor", "galatasaray"), ("trabzonspor", "besiktas"),
            ("real madrid", "barcelona"), ("real madrid", "atletico"), ("barcelona", "espanyol"),
            ("man united", "man city"), ("manchester united", "manchester city"), ("liverpool", "everton"),
            ("liverpool", "man united"), ("liverpool", "manchester united"), ("arsenal", "tottenham"), ("chelsea", "arsenal"),
            ("internazionale", "ac milan"), ("inter milan", "ac milan"), ("roma", "lazio"), ("juventus", "torino"),
            ("juventus", "internazionale"), ("dortmund", "schalke"), ("bayern", "dortmund"), ("paris saint", "marseille"),
            ("psg", "marseille"), ("celtic", "rangers"), ("boca", "river"), ("lakers", "clippers"), ("lakers", "celtics"),
            ("knicks", "nets"), ("turkey", "greece"), ("england", "scotland"), ("argentina", "brazil")]


def sade(ad):
    import unicodedata
    return unicodedata.normalize("NFKD", (ad or "").lower()).encode("ascii", "ignore").decode()


def mac_isaretle(lig, m):
    ev, dep = sade(m["ev"].get("ad")), sade(m["dep"].get("ad"))
    var = lambda ad, k: k in ad
    derbi = any((var(ev, a) and var(dep, b)) or (var(ev, b) and var(dep, a)) for a, b in DERBILER)
    buyuk = sum(1 for ad in (ev, dep) if any(var(ad, b) for b in BUYUKLER))
    milli = lig in dict(MILLI_LIGLER)
    m["tur"] = "basketbol" if "NBA" in lig or "basket" in lig.lower() else ("milli" if milli else "futbol")
    m["derbi"] = derbi
    m["yildiz"] = max(0, min(5, LIG_YILDIZ.get(lig, 0) + buyuk + (2 if derbi else 0)))


def maclar():
    try:
        d = island("/api/maclar?island=1")
    except Exception:
        d = maclar_yerel()
    ek = cached("maclar-milli", 300, lambda: maclar_yerel(MILLI_LIGLER))
    if "hata" not in ek:
        for k in ("bugun", "yarin"):
            d.setdefault(k, []).extend(ek.get(k, []))
        gun = {g["tarih"]: g for g in d.get("gecmis", [])}
        for g in ek.get("gecmis", []):
            if g["tarih"] in gun:
                gun[g["tarih"]]["ligler"].extend(g["ligler"])
        d["canli"] = d.get("canli") or ek.get("canli")
    logolar = [t.get("logo") for bolum in (d.get("bugun", []), d.get("yarin", []), *[g["ligler"] for g in d.get("gecmis", [])])
               for lig in bolum for m in lig["maclar"] for t in (m["ev"], m["dep"])]
    yollar = resimleri_onbellekle(logolar, "logo", (48,))
    for bolum in (d.get("bugun", []), d.get("yarin", []), *[g["ligler"] for g in d.get("gecmis", [])]):
        for lig in bolum:
            for m in lig["maclar"]:
                for t in (m["ev"], m["dep"]):
                    t["logo_yol"] = (yollar.get(t.get("logo")) or {}).get(48)
                mac_isaretle(lig["lig"], m)
    return d


# ---------- grafik: BTC, ETH, USD/TRY, EUR/TRY fiyat gecmisi (Island kripto sekmesi) ----------
# Kaynak: Binance herkese acik piyasa verisi (anahtarsiz; data-api.binance.vision yalnizca piyasa verisi
# sunan aynasi, olmazsa api.binance.com). Hiz siniri dakikada 6000 agirlik; burada 5 dk'da bir 4 istek.
# USD/TRY = USDTTRY (USDT ~ 1 USD), EUR/TRY = EURUSDT x USDTTRY.
GRAFIK_VARLIK = [("BTC", "Bitcoin", "BTCUSDT"), ("ETH", "Ethereum", "ETHUSDT"),
                 ("USD", "Dolar / TL", "USDTTRY"), ("EUR", "Euro / TL", "EURUSDT")]


def binance_kapanis(sembol, aralik, adet):
    for kok in BINANCE:
        try:
            url = f"{kok}/api/v3/klines?symbol={sembol}&interval={aralik}&limit={adet}"
            veri = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "FLUGEL"}), timeout=8))
            return [float(k[4]) for k in veri]
        except Exception:
            continue
    raise RuntimeError(f"{sembol} alinamadi")


def grafik_seri(aralik, adet):
    ham = {s: binance_kapanis(s, aralik, adet) for _, _, s in GRAFIK_VARLIK}
    usdtry = ham["USDTTRY"]
    n = min(len(usdtry), len(ham["EURUSDT"]))
    ham["EURUSDT"] = [round(e * t, 4) for e, t in zip(ham["EURUSDT"][-n:], usdtry[-n:])]
    return ham


def grafik():
    s24 = cached("grafik-24s", 300, lambda: grafik_seri("30m", 48))
    s7 = cached("grafik-7g", 3600, lambda: grafik_seri("4h", 42))
    if "hata" in s24:
        return {"hata": s24["hata"]}
    varliklar = []
    for kisa, ad, sembol in GRAFIK_VARLIK:
        seri24 = s24.get(sembol) or []
        seri7 = s7.get(sembol) or [] if "hata" not in s7 else []
        if not seri24:
            continue
        fiyat = seri24[-1]
        degisim = round(100 * (fiyat - seri24[0]) / seri24[0], 2) if seri24[0] else None
        varliklar.append({"sembol": kisa, "ad": ad, "fiyat": fiyat, "degisim_24s": degisim,
                          "seri_24s": seri24[-48:], "seri_7g": seri7[-48:]})
    return {"varliklar": varliklar, "zaman": time.strftime("%H:%M"), "eski": bool(s24.get("eski") or s7.get("eski"))}


# ---------- kripto izleme listesi, koin listesi, koin grafigi (Island kripto sekmesi + fiyat alarmlari) ----------
# Kaynak: Binance herkese acik piyasa verisi (anahtarsiz). Koin adlari ve beyaz simgeler: cryptocurrency-icons
# (CC0, npm paketi jsDelivr uzerinden), bir kez indirilip ~/.cache/flugel-island/koin altinda tutulur.
KOIN_KOK = os.path.expanduser("~/.cache/flugel-island/koin")
IKON_CDN = "https://cdn.jsdelivr.net/npm/cryptocurrency-icons@0.18.1"
BINANCE = ("https://api.binance.com", "https://data-api.binance.vision")
# sabit paralar ve kaldiracli tokenlar listede gosterilmez
KOIN_DISI = {"USDC", "FDUSD", "TUSD", "USDP", "DAI", "BUSD", "EUR", "TRY", "USDE", "USD1", "PAXG", "XUSD", "BFUSD", "AEUR"}
DONEM = {"1s": ("1m", 60, 30), "24s": ("15m", 96, 120), "7g": ("1h", 168, 600), "30g": ("4h", 180, 1800),
         "1y": ("1d", 365, 3600)}


def binance(yol):
    for kok in BINANCE:
        try:
            return json.load(urllib.request.urlopen(urllib.request.Request(kok + yol, headers={"User-Agent": "FLUGEL"}), timeout=8))
        except Exception:
            continue
    raise RuntimeError("Binance'e ulasilamadi")


def koin_adlari():
    os.makedirs(KOIN_KOK, exist_ok=True)
    p = os.path.join(KOIN_KOK, "adlar.json")
    try:
        if time.time() - os.path.getmtime(p) < 30 * 86400:
            return json.load(open(p))
    except OSError:
        pass
    try:
        ham = json.load(urllib.request.urlopen(IKON_CDN + "/manifest.json", timeout=8))
        adlar = {k["symbol"].upper(): k["name"] for k in ham}
        json.dump(adlar, open(p, "w"))
        return adlar
    except Exception:
        try:
            return json.load(open(p))
        except Exception:
            return {}


def koin_simgeleri(semboller):
    """beyaz SVG simgeleri indirir (yoksa bos dosya: tekrar denenmez); {sembol: yol}"""
    from concurrent.futures import ThreadPoolExecutor
    os.makedirs(KOIN_KOK, exist_ok=True)

    def bir(s):
        y = os.path.join(KOIN_KOK, s.lower() + ".svg")
        if not os.path.exists(y):
            try:
                ham = urllib.request.urlopen(f"{IKON_CDN}/svg/white/{s.lower()}.svg", timeout=8).read()
            except Exception:
                ham = b""
            open(y, "wb").write(ham)
        return s, (y if os.path.getsize(y) else None)
    with ThreadPoolExecutor(6) as h:
        return {s: y for s, y in h.map(bir, semboller) if y}


def doviz_seri(aralik, adet):
    usdtry = [float(k[4]) for k in binance(f"/api/v3/klines?symbol=USDTTRY&interval={aralik}&limit={adet}")]
    return usdtry


def koin_mumlari(sembol, donem):
    aralik, adet, _ = DONEM[donem]
    if sembol in ("USD", "EUR"):
        usd = binance(f"/api/v3/klines?symbol=USDTTRY&interval={aralik}&limit={adet}")
        if sembol == "USD":
            return usd
        eur = binance(f"/api/v3/klines?symbol=EURUSDT&interval={aralik}&limit={adet}")
        n = min(len(usd), len(eur))
        usd, eur = usd[-n:], eur[-n:]
        return [[e[0], *(float(e[i]) * float(u[i]) for i in (1, 2, 3, 4))] for e, u in zip(eur, usd)]
    return binance(f"/api/v3/klines?symbol={sembol}USDT&interval={aralik}&limit={adet}")


def koin(sembol, donem):
    sembol, donem = sembol.upper(), (donem if donem in DONEM else "24s")

    def al():
        m = koin_mumlari(sembol, donem)
        return {"s": sembol, "donem": donem, "t": [int(k[0]) // 1000 for k in m], "a": [float(k[1]) for k in m],
                "y": [float(k[2]) for k in m], "d": [float(k[3]) for k in m], "c": [float(k[4]) for k in m]}
    return cached(f"koin-{sembol}-{donem}", DONEM[donem][2], al)


def kripto_izle(semboller):
    """izleme listesi + alarm koinleri: fiyat, 24 saat degisim, 24 saatlik kucuk grafik, ad, simge"""
    semboller = [s.upper() for s in semboller if s.strip()][:40]
    adlar = koin_adlari()
    koinler = [s for s in semboller if s not in ("USD", "EUR")]
    sonuc = {}
    if koinler:
        cift = json.dumps([s + "USDT" for s in koinler], separators=(",", ":"))
        try:
            for t in binance("/api/v3/ticker/24hr?type=MINI&symbols=" + urllib.parse.quote(cift)):
                s = t["symbol"][:-4]
                f, a = float(t["lastPrice"]), float(t["openPrice"])
                sonuc[s] = {"fiyat": f, "degisim": round(100 * (f - a) / a, 2) if a else None,
                            "yuksek": float(t["highPrice"]), "dusuk": float(t["lowPrice"]), "hacim": float(t["quoteVolume"])}
        except RuntimeError:
            # biri gecersizse toplu istek hata verir: tek tek dene
            for s in koinler:
                try:
                    t = binance(f"/api/v3/ticker/24hr?type=MINI&symbol={s}USDT")
                    f, a = float(t["lastPrice"]), float(t["openPrice"])
                    sonuc[s] = {"fiyat": f, "degisim": round(100 * (f - a) / a, 2) if a else None,
                                "yuksek": float(t["highPrice"]), "dusuk": float(t["lowPrice"]), "hacim": float(t["quoteVolume"])}
                except Exception:
                    pass
    for s in ("USD", "EUR"):
        if s in semboller:
            try:
                k = koin(s, "24s")
                if k.get("c"):
                    f, a = k["c"][-1], k["a"][0]
                    sonuc[s] = {"fiyat": f, "degisim": round(100 * (f - a) / a, 2), "yuksek": max(k["y"]), "dusuk": min(k["d"])}
            except Exception:
                pass
    from concurrent.futures import ThreadPoolExecutor
    simge = koin_simgeleri(koinler)

    def seri_al(s):
        try:
            return s, koin(s, "24s").get("c", [])[::2]
        except Exception:
            return s, []
    with ThreadPoolExecutor(6) as h:
        seriler = dict(h.map(seri_al, [s for s in semboller if s in sonuc]))
    cikti = []
    for s in semboller:
        if s not in sonuc:
            cikti.append({"s": s, "yok": True})
            continue
        seri = seriler.get(s, [])
        ad = {"USD": "Dolar / TL", "EUR": "Euro / TL"}.get(s) or adlar.get(s, s)
        cikti.append({"s": s, "ad": ad, "simge": simge.get(s), "seri": seri, "birim": "TL" if s in ("USD", "EUR") else "$", **sonuc[s]})
    return {"koinler": cikti, "zaman": int(time.time())}


def kripto_liste():
    """Binance'teki butun USDT ciftleri, islem hacmine gore (koin ekleme listesi)"""
    def al():
        adlar = koin_adlari()
        liste = []
        for t in binance("/api/v3/ticker/24hr?type=MINI"):
            sym = t["symbol"]
            if not sym.endswith("USDT"):
                continue
            s = sym[:-4]
            if s in KOIN_DISI or s.endswith(("UP", "DOWN", "BULL", "BEAR")) or float(t["quoteVolume"]) < 50000:
                continue
            f, a = float(t["lastPrice"]), float(t["openPrice"])
            liste.append({"s": s, "ad": adlar.get(s, s), "fiyat": f, "degisim": round(100 * (f - a) / a, 2) if a else None,
                          "hacim": float(t["quoteVolume"])})
        liste.sort(key=lambda k: -k["hacim"])
        return {"koinler": liste, "zaman": int(time.time())}
    d = cached("kripto-liste", 600, al)
    simge = koin_simgeleri([k["s"] for k in d.get("koinler", [])[:80]])
    for k in d.get("koinler", []):
        k["simge"] = simge.get(k["s"]) or (os.path.join(KOIN_KOK, k["s"].lower() + ".svg")
                                           if os.path.exists(os.path.join(KOIN_KOK, k["s"].lower() + ".svg")) and
                                           os.path.getsize(os.path.join(KOIN_KOK, k["s"].lower() + ".svg")) else None)
    return d


