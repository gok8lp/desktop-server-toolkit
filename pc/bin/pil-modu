#!/bin/bash
# Pil modu (sistem-bakim)
#   pil-modu            -> servis: fis cekilince tasarruf, takilinca normal (UPower sinyali, surekli yoklama yok)
#   pil-modu tasarruf   -> elle tasarruf modunu ac (ust cubuk dugmesi)
#   pil-modu normal     -> elle tasarruf modunu kapat
D=~/.cache/sistem-bakim; mkdir -p $D

tasarruf(){
  [ -f $D/pilde ] && return
  touch $D/pilde
  gdctl show 2>/dev/null | awk '/value ⇒/{print $NF; exit}' > $D/parlaklik-fis
  [ "$(cat $D/parlaklik-fis 2>/dev/null || echo 100)" -gt 40 ] && gdctl prefs --monitor eDP-1 --backlight 40 >/dev/null 2>&1
  powerprofilesctl set power-saver
  gsettings set org.gnome.desktop.session idle-delay 180
  gnome-extensions disable blur-my-shell@aunetx 2>/dev/null   # agir efekt pildeyken kapali
  echo "$(date '+%F %T') TASARRUF ($1): parlaklik 40, power-saver, ekran 3 dk" >> $D/pil-modu.log
}

normal(){
  [ -f $D/pilde ] || [ "$2" = zorla ] || return
  rm -f $D/pilde
  gdctl prefs --monitor eDP-1 --backlight "$(cat $D/parlaklik-fis 2>/dev/null || echo 80)" >/dev/null 2>&1
  powerprofilesctl set balanced
  gsettings set org.gnome.desktop.session idle-delay 300
  gnome-extensions enable blur-my-shell@aunetx 2>/dev/null
  echo "$(date '+%F %T') NORMAL ($1): parlaklik geri, balanced" >> $D/pil-modu.log
}

pilde_mi(){ [ "$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null)" = "b true" ]; }

case "$1" in
  tasarruf) tasarruf elle; exit 0 ;;
  normal)   normal elle; exit 0 ;;
esac

if pilde_mi; then tasarruf otomatik; else normal otomatik zorla; fi
gdbus monitor --system --dest org.freedesktop.UPower --object-path /org/freedesktop/UPower 2>/dev/null | \
  while read -r satir; do
    case "$satir" in *OnBattery*) sleep 1; if pilde_mi; then tasarruf otomatik; else normal otomatik; fi;; esac
  done
