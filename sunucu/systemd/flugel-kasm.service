[Unit]
Description=FLUGEL Kasm (gecici sistemler)
Requires=docker.service
After=docker.service network-online.target
# biri baslayinca digeri durur
Conflicts=flugel-webtop.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/stacks/kasm
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
